// Minimal STM32F767 model for HawkHealth (Renode + CI). Version-proof.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 16000000
    IRQ -> cpu@0
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000
rcc: Memory.MappedMemory @ sysbus 0x40023800
    size: 0x400
usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 16000000
    IRQ -> nvic@39
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x40020400, +0x400>
GreenLED: Miscellaneous.LED @ gpioPortB 0
gpioPortB:
    0 -> GreenLED@0
